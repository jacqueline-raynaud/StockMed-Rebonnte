rules_version = '2';

// Regles de securite Firestore de StockMed / Rebonnte.
//
// A deployer depuis la console Firebase (Firestore Database -> Regles) ou avec
// la CLI : firebase deploy --only firestore:rules
//
// Sans ces regles, la base reste ouverte a tout Internet : le fichier
// google-services.json est embarque dans l'APK et n'importe qui peut l'en
// extraire. Ce ne sont pas les cles qui protegent les donnees, ce sont ces
// regles.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // medstock aisles - pas de suppression sinon orpherlin dans medicaments
    match /aisles/{aisleId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // medstock medicines
    match /medicines/{medicineId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // medstock history (pour create au cas ou deux connexions simultanées emai en plus)
    match /history/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    // Tout le reste est refuse par defaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
